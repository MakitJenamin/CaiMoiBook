<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.1" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd">
    <servlet>
        <servlet-name>RegisterController</servlet-name>
        <servlet-class>controllers.RegisterController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>LoginController</servlet-name>
        <servlet-class>controllers.LoginController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>SearchBooks</servlet-name>
        <servlet-class>controllers.SearchBooks</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ShowBooksController</servlet-name>
        <servlet-class>controllers.ShowBooksController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>BorrowRequestController</servlet-name>
        <servlet-class>controllers.BorrowRequestController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>HandleRequestController</servlet-name>
        <servlet-class>controllers.HandleRequestController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>AdminRequestController</servlet-name>
        <servlet-class>controllers.AdminRequestController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>BookDetailController</servlet-name>
        <servlet-class>controllers.BookDetailController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterController</servlet-name>
        <url-pattern>/RegisterController</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>LoginController</servlet-name>
        <url-pattern>/LoginController</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>SearchBooks</servlet-name>
        <url-pattern>/SearchBooks</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ShowBooksController</servlet-name>
        <url-pattern>/ShowBooks</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>BorrowRequestController</servlet-name>
        <url-pattern>/BorrowRequestController</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>HandleRequestController</servlet-name>
        <url-pattern>/HandleRequestController</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AdminRequestController</servlet-name>
        <url-pattern>/AdminRequestController</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>BookDetailController</servlet-name>
        <url-pattern>/BookDetailController</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
    <welcome-file-list>
        <welcome-file>ShowBooks</welcome-file>
    </welcome-file-list>
</web-app>
